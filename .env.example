# 이 파일을 복사해서 .env를 만들고 실제 값을 입력하세요:  cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다. (.env.example에는 실제 키를 넣지 마세요)
# 이미 셸에 설정된 환경변수가 있으면 그 값이 우선합니다.

# Claude API 키 — https://platform.claude.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# (선택) 기본 ./config.yaml 대신 다른 설정 파일 사용
# RAG_CONFIG=./config.prod.yaml
